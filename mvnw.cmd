@echo off
setlocal
set MAVEN_PROJECT_DIR=%~dp0
java -version >nul 2>&1
if %errorlevel% neq 0 (
    echo Error: Java is not installed or not in PATH.
    exit /b 1
)
REM Execute Maven via standard execution plugin or fallback
mvn %*
endlocal